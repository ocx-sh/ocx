import { Command, Option } from "commander";

// A line comment names C-810 and never renders.
/** TSDoc names C-811; it renders only in a published API reference. */
export function buildProgram(): Command {
  const program = new Command();
  program
    .command("ci")
    .description("render or check the pipeline (C-915)")
    .option("--check", "check-only, no writes (C-916)")
    .addOption(new Option("--mode <m>", "mode to run (C-917)"));
  program.command("deploy", "deploy the site (C-918)");
  program.summary('short summary (C-919)');
  return program;
}
