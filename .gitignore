# =============================================================================
# Announce E2E per-run evidence (real PR URLs, live timestamps, container logs
# — scratch). Everything, not just *.json: a `.log` left tracked is one
# `git add -A` away from being committed. The durable record is
# .claude/artifacts/e2e_results_announce.md.
# =============================================================================
test/manual/announce-e2e/results/*
!test/manual/announce-e2e/results/.gitkeep

# Agent scratch: worktrees, logs, tmp — never committed
.agents/

# Rendered project toolchain home (`activate`): derived from `ocx.lock` by any
# lock-reading trigger, so it is a cache, never a source. Relocatable via
# `toolchain-dir`; this covers the default `<project>/.ocx/toolchain`.
.ocx/
.tmp/

# =============================================================================
# Bazel
# =============================================================================
# Convenience symlinks into the output base, recreated by every build.
/bazel-*
# Personal flag overrides, `try-import`ed as the last line of `.bazelrc`. Never
# tracked: it is where a cache credential goes, and a tracked rc carrying a
# value Bazel EXECUTES is remote code execution on `git clone` + `bazel query`.
.bazelrc.user

# crate_universe's splicing lock records this machine's output base, so it is
# a local artifact, never a lock. Bootstrap with CARGO_BAZEL_REPIN=true.
/Cargo.bazel.lock.json
