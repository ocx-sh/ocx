# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The OCX Authors
#
# Pure Git LFS delegation. Taking core.hooksPath over from `git lfs install`
# takes its hooks over too, and this repository tracks its images in LFS —
# without this the working tree checks out pointer files. Same hard failure as
# the stock hook, so behaviour is unchanged by the move.
set -euo pipefail
command -v git-lfs >/dev/null 2>&1 || {
    printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path."
    exit 2
}
exec git lfs post-checkout "$@"
