load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

rust_library(
    name = "ocx_package_manager",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package_manager"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_config",
        "//crates/ocx_console",
        "//crates/ocx_index",
        "//crates/ocx_oci",
        "//crates/ocx_package",
        "//crates/ocx_project",
        "//crates/ocx_shell",
        "//crates/ocx_sign",
        "//crates/ocx_store",
        "//crates/ocx_trust",
        "//crates/ocx_util",
    ],
)

rust_test(
    name = "ocx_package_manager_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The testcase-level half of C-008's exclusion set. Every name here fails
    # under `bazel test` for a reason that is a property of the *test*, not of
    # this graph, and each is still executed by `cargo nextest` — which is what
    # `rust:test:floor` counts, so nothing here shrinks the declared suite.
    # Two causes, both measured:
    #   (a) the testcase walks `crates/*/src` of crates this target does not
    #       depend on. Declaring that as data would make the target a reverse
    #       dependency of every crate without being one in `rdeps`, which is
    #       exactly the shape A1's `a1-graph-too-wide` refuses.
    #   (b) the testcase needs a process of its own (a `set_global_default`
    #       tracing subscriber, a per-test `HOME`, or cargo's crate-directory
    #       CWD). nextest runs one process per testcase; libtest runs threads
    #       in one, and Bazel drives libtest.
    # `--exact` is load-bearing: libtest matches `--skip` as a substring by
    # default, and without it 22 names silently filtered 29 testcases here.
    # The executed count is recorded in `crates/TEST_TARGET_MAP.toml` and rises
    # only, so a skip that widens past its name reds there.
    args = [
        "--test-threads=1",
        "--exact",
        "--skip=activation::one_install_bin_derivation::only_the_store_derives_the_install_bin_directory",
        "--skip=launch::firewall_tests::every_allowlisted_file_still_exists",
        "--skip=launch::firewall_tests::every_launch_exemption_is_enumerated",
        "--skip=launch::firewall_tests::no_process_spawn_outside_launch",
        "--skip=launcher::generate::tests::a_relative_candidate_is_never_bakeable_even_when_it_exists",
    ],
    compile_data = [
        "//test:sigstore/keys/fulcio-ca.crt.pem",
        "//test:sigstore/trusted_root.json",
        "//test:tests/fixtures/golden/key_bundle.json",
        "//test:tests/fixtures/golden/key_referrer_manifest.json",
        "//test:tests/fixtures/golden/keyless_bundle.json",
        "//test:tests/fixtures/golden/keyless_referrer_manifest.json",
        "//test:tests/fixtures/golden/keys/cosign.pub",
        "//crates/ocx_project:src/config.rs",
    ],
    crate = ":ocx_package_manager",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ) + [
        "//crates/ocx_test_support:data",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package_manager"},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_test_support",
    ],
)
