load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//crates/ocx_test_support:isolated.bzl", "crate_tree", "isolated_cases")

package(default_visibility = ["//crates:__subpackages__"])

_SKIPPED = [
    "activation::one_install_bin_derivation::only_the_store_derives_the_install_bin_directory",
    "launch::firewall_tests::no_process_spawn_outside_launch",
    "launcher::generate::tests::a_relative_candidate_is_never_bakeable_even_when_it_exists",
]

rust_library(
    name = "ocx_package_manager",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    # The graph is test-only, so the library carries the seams the acceptance
    # binary (`//crates/ocx_cli:ocx`) needs — `ocx`'s cargo `__testing`
    # forwards this crate's.
    crate_features = ["__testing"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package_manager"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "ocx_package_manager_test",
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The `_SKIPPED` cases run in `:ocx_package_manager_isolated`: they walk `crates/*/src` of crates this target does
    # not depend on, or need a process of their own. `--exact` is load-bearing: libtest matches
    # `--skip` as a substring otherwise.
    args = [
        "--test-threads=1",
        "--exact",
    ] + ["--skip=" + case for case in _SKIPPED],
    compile_data = [
        "//test:sigstore/keys/fulcio-ca.crt.pem",
        "//test:sigstore/trusted_root.json",
        "//test:tests/fixtures/golden/key_bundle.json",
        "//test:tests/fixtures/golden/key_referrer_manifest.json",
        "//test:tests/fixtures/golden/keyless_bundle.json",
        "//test:tests/fixtures/golden/keyless_referrer_manifest.json",
        "//test:tests/fixtures/golden/keys/cosign.pub",
        "//crates/ocx_project:src/config.rs",
    ],
    crate = ":ocx_package_manager",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ) + [
        "//crates/ocx_test_support:data",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package_manager"},
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "ocx_package_manager_doc_test",
    crate = ":ocx_package_manager",
    # rust_doc_test does not inherit the library's features: without these the
    # `__testing`-gated items' doctests silently drop out (C-031 name diff).
    crate_features = ["__testing"],
)

crate_tree()

isolated_cases(
    name = "ocx_package_manager_isolated",
    binary = ":ocx_package_manager_test",
    cases = _SKIPPED,
)
