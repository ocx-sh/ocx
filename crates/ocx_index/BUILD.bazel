rust_doc_test(
    name = "ocx_index_doc_test",
    crate = ":ocx_index",
    # rust_doc_test does not inherit the library's features: without these the
    # `__testing`-gated items' doctests silently drop out (C-031 name diff).
    crate_features = [
        "__testing",
    ],
)

crate_tree()

isolated_cases(
    name = "ocx_index_isolated",
    binary = ":ocx_index_test",
    cases = _SKIPPED,
)
