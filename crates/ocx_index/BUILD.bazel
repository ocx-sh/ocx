load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//crates/ocx_test_support:isolated.bzl", "crate_tree", "isolated_cases")

package(default_visibility = ["//crates:__subpackages__"])

_SKIPPED = [
    "store::wire_grammar_tests::config_json_has_at_most_one_production_writer_and_it_is_the_update_path",
]

filegroup(
    name = "index_wire_fixtures",
    srcs = glob(["tests/fixtures/index_wire/**"]),
)

rust_library(
    name = "ocx_index",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_features = [
        "__testing",
    ],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_index"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "ocx_index_test",
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The `_SKIPPED` cases run in `:ocx_index_isolated`: they walk `crates/*/src` of crates this target does
    # not depend on, or need a process of their own. `--exact` is load-bearing: libtest matches
    # `--skip` as a substring otherwise.
    args = [
        "--test-threads=1",
        "--exact",
    ] + ["--skip=" + case for case in _SKIPPED],
    crate = ":ocx_index",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_index"},
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "dispatch_conformance",
    srcs = [
        "tests/dispatch_conformance.rs",
    ],
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    compile_data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    crate_features = [
        "__testing",
    ],
    data = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_index"},
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_index",
    ],
)

