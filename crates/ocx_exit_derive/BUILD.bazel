load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

package(default_visibility = ["//crates:__subpackages__"])

# Its behaviour is tested through the expansions in `//crates/ocx_exit:derive_test`
# and the compile_fail doctests on `ocx_exit`; a proc-macro crate has no in-crate
# test target of its own.
rust_proc_macro(
    name = "ocx_exit_derive",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["GRAMMAR.md"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_exit_derive"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)
