load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

rust_library(
    name = "ocx_schema",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_schema"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_cli",
        "//crates/ocx_config",
        "//crates/ocx_oci",
        "//crates/ocx_package",
        "//crates/ocx_package_manager",
        "//crates/ocx_project",
    ],
)

# The `ocx_schema` binary (`src/main.rs`, cargo's default `[[bin]]`), built
# by Bazel so that no consumer reads cargo's `target/release/ocx_schema`:
# `target/` is `.bazelignore`d and cannot be a label, so an acceptance module
# reading it was cached over an input no key named (plan_test_speed_tiers.md
# C-020, ADR C-UNCACHED AM-6). Two consumers take it as `data`: the
# `schema_outputs` integration test below (as `CARGO_BIN_EXE_ocx_schema`, the
# name cargo gives the same binary) and the `test_project_env` /
# `test_execution_records` acceptance targets (as `OCX_SCHEMA_BINARY`,
# `test/BUILD.bazel`).
#
# `stamp = 0`, spelled out: the binary embeds no build metadata, and
# `bazel:tag:guard` clause 2 credits only an explicitly specified `stamp = 0`
# (rules_rust defaults a `rust_binary` to -1).
rust_binary(
    name = "ocx_schema_bin",
    srcs = ["src/main.rs"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_schema"},
    stamp = 0,
    version = "0.6.2",
    visibility = [
        "//crates:__subpackages__",
        "//test:__pkg__",
    ],
    deps = [":ocx_schema"],
)

rust_test(
    name = "ocx_schema_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    crate = ":ocx_schema",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ) + [
        "//crates/ocx_cli:api_data",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_schema"},
    deps = all_crate_deps(normal_dev = True),
)

