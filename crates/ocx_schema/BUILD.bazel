rust_test(
    name = "schema_outputs",
    srcs = [
        "tests/schema_outputs.rs",
    ],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    compile_data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    data = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ) + [":ocx_schema_bin"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    # `CARGO_BIN_EXE_ocx_schema` is what cargo sets for an integration test of
    # a package with a `[[bin]]`; the two binary contracts at the end of
    # `tests/schema_outputs.rs` read it through `env!`. A `rootpath` is relative
    # to the runfiles root, which is the test's working directory under Bazel.
    rustc_env = {
        "CARGO_BIN_EXE_ocx_schema": "$(rootpath :ocx_schema_bin)",
        "CARGO_MANIFEST_DIR": "crates/ocx_schema",
    },
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_schema",
        "//crates/ocx_cli",
        "//crates/ocx_config",
        "//crates/ocx_oci",
        "//crates/ocx_package",
        "//crates/ocx_package_manager",
        "//crates/ocx_project",
    ],
)
