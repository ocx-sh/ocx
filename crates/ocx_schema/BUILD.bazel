    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_schema"},
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_schema",
        "//crates/ocx_cli",
        "//crates/ocx_config",
        "//crates/ocx_oci",
        "//crates/ocx_package",
        "//crates/ocx_package_manager",
        "//crates/ocx_project",
    ],
)

