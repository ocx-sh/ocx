load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

rust_library(
    name = "ocx_script",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_script"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_config",
        "//crates/ocx_oci",
        "//crates/ocx_util",
    ],
)

rust_test(
    name = "ocx_script_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The testcase-level half of C-008's exclusion set. Every name here fails
    # under `bazel test` for a reason that is a property of the *test*, not of
    # this graph, and each is still executed by `cargo nextest` — which is what
    # `rust:test:floor` counts, so nothing here shrinks the declared suite.
    # Two causes, both measured:
    #   (a) the testcase walks `crates/*/src` of crates this target does not
    #       depend on. Declaring that as data would make the target a reverse
    #       dependency of every crate without being one in `rdeps`, which is
    #       exactly the shape A1's `a1-graph-too-wide` refuses.
    #   (b) the testcase needs a process of its own (a `set_global_default`
    #       tracing subscriber, a per-test `HOME`, or cargo's crate-directory
    #       CWD). nextest runs one process per testcase; libtest runs threads
    #       in one, and Bazel drives libtest.
    # `--exact` is load-bearing: libtest matches `--skip` as a substring by
    # default, and without it 22 names silently filtered 29 testcases here.
    # The executed count is recorded in `crates/TEST_TARGET_MAP.toml` and rises
    # only, so a skip that widens past its name reds there.
    args = [
        "--test-threads=1",
        "--exact",
        "--skip=firewall_tests::no_starlark_import_outside_firewall",
    ],
    crate = ":ocx_script",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_script"},
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "ocx_script_doc_test",
    crate = ":ocx_script",
)
