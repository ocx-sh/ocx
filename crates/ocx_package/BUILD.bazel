load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

rust_library(
    name = "ocx_package",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_features = [
        "__testing",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_config",
        "//crates/ocx_index",
        "//crates/ocx_oci",
        "//crates/ocx_store",
        "//crates/ocx_util",
    ],
)

rust_test(
    name = "ocx_package_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    crate = ":ocx_package",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package"},
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "index_variant_derivation",
    srcs = [
        "tests/index_variant_derivation.rs",
    ],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    compile_data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    crate_features = [
        "__testing",
    ],
    data = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ) + [
        "//crates/ocx_index:index_wire_fixtures",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_package"},
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_package",
        "//crates/ocx_config",
        "//crates/ocx_index",
        "//crates/ocx_oci",
        "//crates/ocx_store",
        "//crates/ocx_util",
    ],
)

