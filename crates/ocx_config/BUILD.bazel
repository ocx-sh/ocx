load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

rust_library(
    name = "ocx_config",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_features = [
        "__test_scaffolding",
        "__testing",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_config"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_oci",
        "//crates/ocx_trust",
        "//crates/ocx_util",
    ],
)

rust_test(
    name = "ocx_config_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    compile_data = [
        "//test:sigstore/keys/fulcio-ca.crt.pem",
        "//test:sigstore/keys/fulcio-ca.key.pem",
    ],
    crate = ":ocx_config",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_config"},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_test_support",
    ],
)

rust_doc_test(
    name = "ocx_config_doc_test",
    crate = ":ocx_config",
    # rust_doc_test does not inherit the library's features: without these the
    # `__testing`-gated items' doctests silently drop out (C-031 name diff).
    crate_features = [
        "__test_scaffolding",
        "__testing",
    ],
)
