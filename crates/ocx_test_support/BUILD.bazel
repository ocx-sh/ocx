load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//crates/ocx_test_support:isolated.bzl", "crate_tree", "isolated_cases")

package(default_visibility = ["//crates:__subpackages__"])

_SKIPPED = [
    "anyhow_only_in_cli_runtime",
    "clap_env_feature_is_off_in_the_release_build",
    "crate_map_toml_matches_rust_table",
    "deps_direction",
    "dynamic_read_ratchet",
    "env_ban_is_wired_for_cargo_and_bazel",
    "every_boundary_needle_names_something_live",
    "every_derived_classification_type_is_registered_or_reached",
    "every_public_item_of_ocx_util_has_a_consumer",
    "every_repo_path_literal_in_a_test_names_something_live",
    "every_source_file_is_reachable",
    "every_utility_error_reaching_the_cli_is_armed",
    "internal_crates_block_is_complete_and_sorted",
    "manifests_inherit_lints_and_never_publish",
    "needle_liveness_and_the_absence_exemption_discriminate",
    "no_hand_written_classification_impl",
    "no_log_shim",
    "no_module_path_in_output",
    "oci_identifier_mint_ratchet",
    "raw_env_reads_are_the_pinned_residue",
    "readme_may_depend_on_rows_match_the_crate_map",
    "release_feature_set_excludes_testing_seams",
    "resolver_resolves_aliases_that_name_unlike_error_types",
    "resolver_resolves_each_error_declaration_apart",
    "shim_env_literals_are_registry_names",
    "ssrf_guard_ratchet",
    "test_scaffolding_is_declared_where_it_is_gated_and_forwarded_nowhere",
    "testing_feature_forward_list_matches_grep",
    "tests_hold_no_inert_loop",
]

# The cases that shell out to `cargo metadata` or `cargo tree`: no cargo inside a Bazel test, so
# they run in `rust:test:workspace-cargo`. `scripts/test_bundle.py` names the same set.
_NEEDS_CARGO = [
    "anyhow_only_in_cli_runtime",
    "clap_env_feature_is_off_in_the_release_build",
    "crate_map_toml_matches_rust_table",
    "deps_direction",
    "release_feature_set_excludes_testing_seams",
]

filegroup(
    name = "data",
    srcs = glob(["data/**"]),
)

rust_library(
    name = "ocx_test_support",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_test_support"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "ocx_test_support_test",
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    crate = ":ocx_test_support",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_test_support"},
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "boundary",
    srcs = [
        "tests/boundary.rs",
    ],
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    compile_data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    data = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_test_support"},
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_test_support",
    ],
)

rust_test(
    name = "workspace_structure",
    srcs = [
        "tests/workspace_structure.rs",
    ],
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The `_SKIPPED` cases walk `crates/*/src` of crates this target does not depend on, or need a
    # process of their own. `:workspace_structure_isolated` runs all but `_NEEDS_CARGO` under Bazel;
    # `rust:test:workspace-cargo` runs those. `--exact` is load-bearing: libtest matches `--skip` as
    # a substring otherwise.
    args = [
        "--test-threads=1",
        "--exact",
    ] + ["--skip=" + case for case in _SKIPPED],
    compile_data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    data = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_test_support"},
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_test_support",
    ],
)

rust_doc_test(
    name = "ocx_test_support_doc_test",
    crate = ":ocx_test_support",
)

crate_tree()

exports_files(["run_each_case.sh"])

isolated_cases(
    name = "workspace_structure_isolated",
    binary = ":workspace_structure",
    cases = [case for case in _SKIPPED if case not in _NEEDS_CARGO],
)
