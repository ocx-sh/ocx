load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//crates/ocx_test_support:isolated.bzl", "crate_tree")

package(default_visibility = ["//crates:__subpackages__"])

# `ocx-shim`, the Windows launcher, as the acceptance suite's
# `OCX_SHIM_BINARY` (`test/bazel.bzl`; `test/taskfile.yml`'s `.build-binaries`
# copies it to `test/bin/ocx-shim`). Only `test_windows_shim.py` executes it,
# on Windows; elsewhere it is a compile-only check.
#
# `stamp = 0`, spelled out: `bazel:tag:guard` clause 2 credits only an
# explicitly specified `stamp = 0` (rules_rust defaults a `rust_binary` to -1).
rust_binary(
    name = "ocx_shim",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/main.rs",
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_shim"},
    stamp = 0,
    version = "0.6.2",
    visibility = [
        "//crates:__subpackages__",
        "//test:__pkg__",
    ],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "ocx_shim_bin_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    crate_name = "ocx_shim_bin",
    crate_root = "src/main.rs",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_shim"},
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

crate_tree()
