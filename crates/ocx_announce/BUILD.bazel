load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

rust_library(
    name = "ocx_announce",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    # The graph is test-only, so the library carries the seams the acceptance
    # binary (`//crates/ocx_cli:ocx`) needs — `ocx`'s cargo `__testing`
    # forwards this crate's.
    crate_features = ["__testing"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_announce"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "ocx_announce_test",
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    crate = ":ocx_announce",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_announce"},
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "ocx_announce_doc_test",
    crate = ":ocx_announce",
    # rust_doc_test does not inherit the library's features: without these the
    # `__testing`-gated items' doctests silently drop out (C-031 name diff).
    crate_features = ["__testing"],
)
