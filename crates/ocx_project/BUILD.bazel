load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//crates/ocx_test_support:isolated.bzl", "crate_tree", "isolated_cases")

package(default_visibility = ["//crates:__subpackages__"])

_SKIPPED = [
    "activate::tests::the_ladder_is_constructed_only_inside_the_two_shared_resolvers",
]

# Read across the package boundary by another crate's `include_str!`.
exports_files([
    "src/config.rs",
])

rust_library(
    name = "ocx_project",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    # The graph is test-only, so the library carries the fault seam the
    # acceptance binary (`//crates/ocx_cli:ocx`) needs — `ocx`'s cargo
    # `__testing` forwards this crate's.
    crate_features = ["__testing"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_project"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "ocx_project_test",
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The `_SKIPPED` cases run in `:ocx_project_isolated`: they walk `crates/*/src` of crates this target does
    # not depend on, or need a process of their own. `--exact` is load-bearing: libtest matches
    # `--skip` as a substring otherwise.
    args = [
        "--test-threads=1",
        "--exact",
    ] + ["--skip=" + case for case in _SKIPPED],
    compile_data = [
        "//test:sigstore/keys/fulcio-ca.crt.pem",
    ],
    crate = ":ocx_project",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_project"},
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "ocx_project_doc_test",
    crate = ":ocx_project",
    # rust_doc_test does not inherit the library's features.
    crate_features = ["__testing"],
)

crate_tree()

isolated_cases(
    name = "ocx_project_isolated",
    binary = ":ocx_project_test",
    cases = _SKIPPED,
)
