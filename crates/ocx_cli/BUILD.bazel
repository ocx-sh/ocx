# The fixed `__testing` provenance, as `build.rs`'s `TESTING_PLACEHOLDERS`
# bakes it for cargo — keep the two lists equal. Bazel never runs `build.rs`,
# so without these every `option_env!` in `app/build_info.rs` reads `None` and
# the release provenance scan (`task release:provenance:proof`) finds no marker
# in the binary under test. On the library, not the binary: the reads live
# here. Sound because this graph is test-only — releases stay on cargo-dist.
#
# The toolchain-derived rows `build.rs` gets from vergen are spelled out:
# `VERGEN_RUSTC_SEMVER` is `MODULE.bazel`'s pin, `VERGEN_CARGO_DEBUG` is
# `false` because fastbuild emits no debug info (vergen reads cargo's `DEBUG`),
# and the triple is read off the target platform. A platform not listed gets
# no triple, so `build` drops out of `ocx version` and
# `test_version_json_reports_placeholder_provenance` reds by name.
_TESTING_PROVENANCE = {
    "CARGO_MANIFEST_DIR": "crates/ocx_cli",
    "GITHUB_REF": "refs/heads/placeholder",
    "GITHUB_REPOSITORY": "placeholder/placeholder",
    "GITHUB_RUN_ID": "0",
    "GITHUB_SERVER_URL": "https://ci.invalid",
    "GITHUB_SHA": "0000000000000000000000000000000000000000",
    "GITHUB_WORKFLOW": "placeholder",
    "VERGEN_BUILD_TIMESTAMP": "1970-01-01T00:00:00.000000000Z",
    "VERGEN_CARGO_DEBUG": "false",
    "VERGEN_GIT_COMMIT_TIMESTAMP": "1970-01-01T00:00:00.000000000Z",
    "VERGEN_GIT_DESCRIBE": "placeholder-g00000000",
    "VERGEN_GIT_DIRTY": "true",
    "VERGEN_GIT_SHA": "0000000000000000000000000000000000000000",
    "VERGEN_RUSTC_SEMVER": "1.95.0",
    "__OCX_BUILD_CHANNEL": "test",
}

# `@rules_rust//rust/platform` selector -> the triple the binary reports. It has
# no gnullvm selector; its msvc one matches the same os and cpu constraints.
_TARGET_TRIPLES = {
    "aarch64-apple-darwin": "aarch64-apple-darwin",
    "aarch64-pc-windows-msvc": "aarch64-pc-windows-gnullvm",
    "aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin": "x86_64-apple-darwin",
    "x86_64-pc-windows-msvc": "x86_64-pc-windows-gnullvm",
    "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu",
}

rust_library(
    name = "ocx_cli",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    # `app::seam`, as cargo's `--features ocx/__testing` compiles it into the
    # acceptance binary; the tier crates' libraries enable their own.
    crate_features = ["__testing"],
    crate_name = "ocx",
    edition = "2024",
    rustc_env = select({
        "@rules_rust//rust/platform:" + selector: _TESTING_PROVENANCE | {"VERGEN_CARGO_TARGET_TRIPLE": triple}
        for selector, triple in _TARGET_TRIPLES.items()
    } | {"//conditions:default": _TESTING_PROVENANCE}),
    version = "0.6.2",
    deps = all_crate_deps(normal = True),
)

# The `ocx` binary the acceptance suite runs (`src/main.rs`, cargo's `[[bin]]`),
# built by Bazel so that no acceptance target reads cargo's `target/`: every
# `//test` target takes it as `data` and the runner resolves its
# rlocationpath (`test/bazel.bzl`). `task test`'s `.build-binaries` copies the
# same output into `test/bin/` for the pytest entry points. The provenance
# placeholders arrive through `:ocx_cli`'s `rustc_env` above.
#
# `stamp = 0`, spelled out: the binary embeds no build metadata, and
# `bazel:tag:guard` clause 2 credits only an explicitly specified `stamp = 0`
# (rules_rust defaults a `rust_binary` to -1).
rust_binary(
    name = "ocx",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    # Not `ocx`: that is the library's crate name, which this crate links.
    crate_name = "ocx_bin",
    crate_root = "src/main.rs",
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_cli"},
    stamp = 0,
    version = "0.6.2",
    visibility = [
        "//crates:__subpackages__",
        "//test:__pkg__",
    ],
    deps = all_crate_deps(normal = True) + [":ocx_cli"],
)

rust_test(
    name = "ocx_cli_test",
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    # The `_SKIPPED` cases run in `:ocx_cli_isolated`: they walk `crates/*/src` of crates this target does
    # not depend on, or need a process of their own. `--exact` is load-bearing: libtest matches
    # `--skip` as a substring otherwise.
    args = [
        "--test-threads=1",
        "--exact",
    ] + ["--skip=" + case for case in _SKIPPED],
    compile_data = [
        "//test:sigstore/keys/fulcio-ca.crt.pem",
    ],
    crate = ":ocx_cli",
    data = glob(
        ["src/**"],
        allow_empty = True,
    ) + [
        "//test:tests/test_index.py",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_cli"},
    deps = all_crate_deps(normal_dev = True),
)

# The in-process CLI seam's tests (`app::seam::run`, ADR C-SEAM) and every port
# that drives it, re-run under a POISONED environment. `run` installs the
# caller's environment hermetically through `ocx_env`; a third-party
# crate reading the process environment past that layer (`dirs`, `reqwest`'s
# proxy discovery, `docker_credential`, the TLS root loaders) sees these values
# instead, and the read fails the case rather than picking up the host's:
# `HOME`, `XDG_CONFIG_HOME` and `OCX_HOME` name `testdata/poisoned_home`,
# where each config tier's `config.toml` is a DIRECTORY: the loader keeps a
# candidate that exists and is not a symlink, and reading a directory is an
# error, so an ambient read fails the case. (A regular file would reach the
# sandbox as a symlink, which the loader skips; a path under `/dev/null` reads
# as unreadable and is skipped too — both neutralise the read instead of
# failing it.) `DOCKER_CONFIG` holds an invalid `config.json`. The paths are
# absolute through `/proc/self/cwd` (Linux): libtest runs from the runfiles
# root, the seam never changes the process cwd, and Bazel's test-setup
# replaces a relative `HOME` with `$TEST_TMPDIR`. The presence test below
# checks each fixture's shape, so a path that does not resolve reds.
# proxies an unresolvable host. `app::seam::tests::seam_
# poisoned_environment_is_present_under_its_bazel_target` reds if this dict is
# dropped. The positional `seam::` filter selects every test in a module named
# `seam`; `ocx_cli_test` above runs the same tests unpoisoned.
#
# An `sh_test` over `ocx_cli_test`'s own binary, not a second `rust_test`: a
# `rust_test(crate = ":ocx_cli")` is a second full test-mode compile of the
# crate (aquery: 6 `Rustc` actions under this package with it, 5 without), for
# the same bytes. `sh_test` symlinks its one `srcs` file as the executable and
# collects that target's runfiles, so this runs the very binary `ocx_cli_test`
# built, in a process of its own, with only the `seam::` cases selected —
# which is also why the global-subscriber test skipped above can run here.
sh_test(
    name = "ocx_cli_seam_test",
    srcs = [":ocx_cli_test"],
    # `--test-threads=1`: the seam serialises on a process-global lock, and a
    # seam test sets a process variable to prove it is not read.
    args = [
        "--test-threads=1",
        "seam::",
    ],
    data = [
        "testdata/poisoned_home/.config/ocx/config.toml/POISONED",
        "testdata/poisoned_home/docker/config.json",
        "testdata/poisoned_home/ocx_home/config.toml/POISONED",
    ],
    env = {
        "ALL_PROXY": "http://poisoned-ambient-read.invalid:9",
        "DOCKER_CONFIG": "/proc/self/cwd/crates/ocx_cli/testdata/poisoned_home/docker",
        "HOME": "/proc/self/cwd/crates/ocx_cli/testdata/poisoned_home",
        "HTTPS_PROXY": "http://poisoned-ambient-read.invalid:9",
        "HTTP_PROXY": "http://poisoned-ambient-read.invalid:9",
        "NO_PROXY": "poisoned-ambient-read.invalid",
        "OCX_AUTH_ocx_sh_TOKEN": "poisoned-ambient-read",
        "OCX_AUTH_ocx_sh_TYPE": "poisoned-ambient-read",
        "OCX_AUTH_ocx_sh_USER": "poisoned-ambient-read",
        "OCX_HOME": "/proc/self/cwd/crates/ocx_cli/testdata/poisoned_home/ocx_home",
        "SSL_CERT_DIR": "/dev/null/poisoned-ambient-read",
        "SSL_CERT_FILE": "/dev/null/poisoned-ambient-read",
        "XDG_CONFIG_HOME": "/proc/self/cwd/crates/ocx_cli/testdata/poisoned_home/.config",
        "all_proxy": "http://poisoned-ambient-read.invalid:9",
        "http_proxy": "http://poisoned-ambient-read.invalid:9",
        "https_proxy": "http://poisoned-ambient-read.invalid:9",
        "no_proxy": "poisoned-ambient-read.invalid",
    },
)

