rust_test(
    name = "macos_self_contained",
    srcs = [
        "tests/macos_self_contained.rs",
    ],
    aliases = aliases(),
    # `--test-threads=1`. 25 testcases across 8 crates mutate the *process*
    # environment (`std::env::set_var`) inside the test body. nextest runs one
    # process per testcase, so that is safe there; libtest runs them as threads
    # in one process, and Bazel drives libtest — measured flaky, not merely
    # slower. Serialising the binary is what makes `bazel test` deterministic.
    args = [
        "--test-threads=1",
    ],
    compile_data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ),
    data = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = ["tests/*.rs"],
    ) + [":ocx"],
    edition = "2024",
    # `CARGO_BIN_EXE_ocx` is what cargo sets for an integration test of a
    # package with a `[[bin]]`; `otool` runs against it. A `rootpath` is
    # relative to the runfiles root, the test's working directory.
    rustc_env = {
        "CARGO_BIN_EXE_ocx": "$(rootpath :ocx)",
        "CARGO_MANIFEST_DIR": "crates/ocx_cli",
    },
    version = "0.6.2",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":ocx_cli",
    ],
)

