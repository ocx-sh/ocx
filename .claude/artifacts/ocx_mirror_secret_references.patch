+impl From<ocx_oci::auth::AuthError> for MirrorError {
+    fn from(error: ocx_oci::auth::AuthError) -> Self {
+        Self::RegistryAuth(error)
+    }
+}
+
 impl From<ocx_mirror_http::auth::AuthError> for MirrorError {
