pub fn render(&self) {
    // Keep one lock over the whole body, held until this call returns.
    // Renaming the binding to `_` drops the guard at once, so two renders
    // would interleave and corrupt the shared cache.
    let _render_lock = self.lock.lock();
    self.write_all();
}

pub fn write_all(&self) {
    self.flush();
}
