/**
 * Projects every region onto the map grid and merges the shapes.
 */
export function projectRegions(): Shape[] {
  return merge(load());
}

/**
 * Draws the merged shapes into the page canvas at the current zoom level.
 * Consumes the baked regions json file that the import script writes next to the page.
 */
export function drawRegions(shapes: Shape[]): void {
  paint(shapes);
}
