//! Module doc names C-801; a module doc renders nowhere outside the repo.

use clap::Parser;

/// Private helper, never rendered (C-802, adr_decoy.md).
fn helper() {}

/// Activate a tier (C-901).
#[derive(Parser, schemars::JsonSchema)]
#[command(about = "Run the tool (C-902)", long_about = None)]
pub struct Cli {
    /// The tier to use (C-903, see [`Self::tier`]).
    // Guard: C-803 stays in a line comment, which never renders.
    #[arg(long, help = "Tier name (C-904)")]
    pub tier: String,
}

#[derive(schemars::JsonSchema)]
#[schemars(description = "Hand-set description (C-905)")]
pub struct Report {
    pub ok: bool,
}

pub fn schema() -> serde_json::Value {
    serde_json::json!({ "description": "Hand-written schema (C-906)" })
}

pub struct Server;

impl Server {
    /// Search the catalog (C-907).
    #[tool]
    async fn search(&self) {}

    /// Rustdoc only; the description attribute wins (C-804).
    #[tool(description = "Fetch a package (C-908)")]
    async fn fetch(&self) {}
}

pub fn build() -> clap::Command {
    clap::Command::new("x").about("Built by hand (C-909)")
}

