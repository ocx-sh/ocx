{
    "taskfile": {
        "outputTo": "terminal",
    },
    // Exclude the Rust build dir from Coverage Gutters' recursive search.
    // lcov.info lives at the workspace root, so this speeds up file discovery.
    "coverage-gutters.ignoredPathGlobs": "**/{node_modules,venv,.venv,vendor,target}/**",
    // ocx.lock is TOML; without this the TOML extension never opens it, so the
    // `**/ocx.lock` schema rule in taplo.toml can never fire.
    "files.associations": {
        "ocx.lock": "toml",
    },
    // Hide Python build artifacts from the explorer.
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.pyc": true,
    },
    // Agent worktrees under `.agents/worktrees/` are full, independent copies of
    // this workspace. Without these excludes rust-analyzer discovers each one as
    // another Cargo workspace and indexes it end to end -- one index is already
    // ~4 GB resident, so three concurrent agents exhaust RAM+swap on a 32 GB
    // machine. They are disposable scratch trees; the agent working in one runs
    // its own cargo, and nobody edits them in this editor window.
    "rust-analyzer.files.excludeDirs": [
        ".agents/worktrees",
        "target",
    ],
    "files.watcherExclude": {
        "**/.agents/worktrees/**": true,
        "**/target/**": true,
    },
    "search.exclude": {
        "**/.agents/worktrees": true,
    },
}
