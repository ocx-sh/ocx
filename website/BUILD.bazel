#
# The Astro Starlight site as one coarse target (C-023). The BZL-JS-01/BZL-JS-03
# exemption, the tag decision, why the output is a `.tar`, and the one-label
# patch that closes the `test/doc_scripts` gap are all in `site.bzl`'s module
# docstring; this file is the wiring.
#
# Declaring this BUILD file makes `website/` a package, so `//:` labels can no
# longer reach into it. No label anywhere spells `//:website/…`, so nothing broke.

load("//website:site.bzl", "site_target")

# Everything astro reads, as one glob.
#
# `redirects.d/**` is read at config time by `plugins/redirects.mjs`
# (`loadRedirects` -> `readdirSync`); without it astro.config.mjs throws in the
# sandbox. `old-urls.txt` and `lighthouse.budgets.mjs` are read only by the
# node tests and `scripts/lighthouse.mjs`, never by `astro build`, so they stay out.
#
# The exclusions keep this rule from consuming its own or another tool's output:
# `dist` is where `task website:build` writes, `.astro` is astro's generated
# types and content cache, and `node_modules` is pnpm's install tree
# (`website/node_modules` is also in `.bazelignore`). An input set containing a
# previous output re-keys the action on every run, which reads exactly like a
# rule with an undeclared input and is not one.
#
# `src/**` deliberately includes the GENERATED, gitignored subtrees —
# `src/_scripts/**` above all, which is a hard prerequisite (`site.bzl` refuses
# by name without it), plus `src/public/casts`, `src/public/data`,
# `src/public/schemas` and `src/content/docs/reference/dependencies.md`. They
# are files the site embeds, so they belong in the key.
#
# `allow_empty = False` is the floor — a glob that matched nothing would
# otherwise declare a rule whose inputs are the config files alone, and
# `bazel build //website:site` would report success over a site nobody built.
_SITE_SRCS = glob(
    [
        "plugins/**",
        "redirects.d/**",
        "src/**",
    ],
    allow_empty = False,
    exclude = [
        "node_modules/**",
        "src/node_modules/**",
    ],
) + [
    "astro.config.mjs",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "//:CHANGELOG.md",
]

site_target(
    name = "site",
    srcs = _SITE_SRCS,
    # C-023's `test/doc_scripts/**/*.sh` edge, and it is EMPTY.
    #
    # Those sources live in the `//test/doc_scripts` package and are not
    # exported; measured, a label naming one of them fails analysis with
    # `Visibility error`. The one-label patch that package's owner applies is
    # spelled out in `site.bzl`'s docstring, and this is the line that consumes
    # it:
    #
    #     doc_scripts = ["//test/doc_scripts:doc_script_sources"],
    #
    # Nothing here enforces the flip, and nothing here should: the enforcement
    # is `scripts/bazel_hermeticity_proofs.py --check-declared --label
    # //website:site`, which reds `hermetic-declared-input-missing` for exactly
    # as long as this stays `[]`. That red is S-014, and S-014 is what gates
    # removing `no-remote-cache` from this rule.
    doc_scripts = [],
)

# Website files acceptance modules read, declared on exactly the `//test`
# targets that read them (plan_test_speed_tiers.md C-020, `test/BUILD.bazel`
# `module_data`).
#
# `src/public/schemas/metadata/v1.json` is GENERATED (`task schema`,
# gitignored) and exported by name anyway: `test/tests/test_schema.py` reads
# that very file in the source tree, so its bytes are the input and naming it
# keys the target on them. On a tree where `task schema` never ran the target
# fails with Bazel's `missing input file`, which is the same refusal the
# module's own "Run `task schema:generate`" assertion makes, one step earlier.
exports_files(
    [
        "recordings.taskfile.yml",
        "src/public/schemas/metadata/v1.json",
    ],
    visibility = ["//test:__pkg__"],
)

# Every taskfile in this package — the half of the root `task` include graph
# that lives here (`//:taskfiles` is the other half).
filegroup(
    name = "taskfiles",
    srcs = ["taskfile.yml"] + glob(
        ["*.taskfile.yml"],
        allow_empty = False,
    ),
    visibility = ["//test:__pkg__"],
)

# `scripts/publish_doc_scripts.py`, which `task website:scripts:publish` runs.
filegroup(
    name = "publish_scripts",
    srcs = glob(
        ["scripts/**"],
        allow_empty = False,
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//test:__pkg__"],
)

# The docs pages, for the generator test that checks every help-text URL lands
# on a page and anchor (`//crates/ocx_schema:docs_generator`).
filegroup(
    name = "docs_content",
    srcs = glob(
        ["src/content/docs/**"],
        allow_empty = False,
    ),
    visibility = ["//crates/ocx_schema:__pkg__"],
)
