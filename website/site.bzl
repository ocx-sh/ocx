"""The Astro Starlight site as one coarse build target (C-023).

`site_target()` is the whole surface. It declares a single `genrule` that runs
`pnpm install --frozen-lockfile` and then `pnpm exec astro build`, and writes the
rendered site as one `.tar` holding `docs/` and `schemas/` (the two trees
`task website:build` leaves under `dist/`).

## The BZL-JS-01 / BZL-JS-03 exemption

This rule takes no `npm_translate_lock` and adopts no `rules_js`. Both rules are
scoped to rules_js ingestion, and the website is a minority slice of a polyglot
migration justified by Rust; the reasoning is `adr_bazel_build_adoption.md`
§ "The BZL-JS exemption". The price is coarse skipping: the site rebuilds or it
does not, with no per-file JS caching.

## Tags

`no-remote-cache`: the rule's hermeticity is not proven, so an entry never
crosses a machine boundary. It stops no local reuse; Skyframe decides a build
action's up-to-dateness from declared inputs alone. `requires-network`:
`pnpm install` fetches the closure, and the in-execroot store below means it
fetches on every cold run. The three hermeticity checks in
`scripts/bazel_hermeticity_proofs.py` (`--check-declared|--check-ambient|
--check-tool-pin` against `//website:site`) gate removing `no-remote-cache`;
none has been re-run against the Astro build.

## The gap this package cannot close

C-023 requires `//test/doc_scripts/**/*.sh` in the declared inputs. That
package is not visible from here, so `website/BUILD.bazel` passes
`doc_scripts = []` until `//test/doc_scripts` exports a `doc_script_sources`
filegroup visible to `//website:__pkg__`. The published copies under
`website/src/_scripts/` are declared through `src/**`, so an edit invalidates
once `task website:scripts:publish` has run; in the window before that the
cache answers with the old site (`hermetic-declared-input-missing`).

## Why the published copies are an input

~30 pages include `\\<\\<\\< @/_scripts/<slug>.sh` snippets, and the build aborts
on the first missing one. The published tree is therefore the one hard
prerequisite: the rule declares `src/**` and refuses at action time, naming the
task that writes them, when the tree is empty. Generated schemas, casts and the
SBOM page are not prerequisites; the build runs clean without them.

## The output is a `.tar`

The hermeticity gate reads an artifact with `digest_of(path)`, which is
`path.read_bytes()`. A tree artifact would make that raise and compare equal to
itself, so the rule emits one file, written with `--sort=name --mtime=@0
--owner=0 --group=0 --numeric-owner` so tar's framing never differs between
builds. `task website:bazel:build` unpacks it.

`OCX_DEPLOY_TARGET` no longer exists: a build action inherits no environment
and the site has no per-target variant.
"""

visibility("private")

SITE_TAGS = [
    "no-remote-cache",
    "requires-network",
]

# Written with `ctx.actions.write`, not inlined in a `genrule` heredoc, so the
# text reaches the file byte for byte and a change to it re-keys the action.
def _written_file_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(output = out, content = ctx.attr.text, is_executable = True)
    return DefaultInfo(files = depset([out]))

_written_file = rule(
    implementation = _written_file_impl,
    attrs = {"text": attr.string(mandatory = True)},
    doc = "Materialise a generated script whose bytes are an action input.",
)

_SITE_RUNNER = """#!/bin/bash
# GENERATED by website/site.bzl. There is no source copy: the bytes are written
# by `ctx.actions.write`, so a change to them re-keys the site action.
#
# argv: <pnpm> <node> <website/package.json> <out.tar>
#
# Never leaves the EXECROOT: everything it reads is declared and everything it
# writes belongs to the action, so it runs sandboxed with no `no-sandbox`.
set -euo pipefail

fail() {
    echo "$0: $*" >&2
    exit 1
}

# An absolute path survives the `cd` into the package directory.
absolutise() {
    case "$1" in
        /*) printf '%s\\n' "$1" ;;
        *) printf '%s/%s\\n' "$PWD" "$1" ;;
    esac
}

[ "$#" -eq 4 ] || fail "usage: <pnpm> <node> <website/package.json> <out.tar>"
pnpm=$(absolutise "$1")
node=$(absolutise "$2")
site=$(dirname "$3")
out=$(absolutise "$4")

[ -x "$pnpm" ] || fail "no executable pnpm launcher at $pnpm (@tools//:pnpm)"
[ -x "$node" ] || fail "no executable node launcher at $node (@tools//:node)"
[ -d "$site" ] || fail "no package directory at $site"

cd "$site"

[ -f astro.config.mjs ] || fail \\
    "no astro.config.mjs in $PWD - the site sources are not in the execroot, \\
which means the glob in website/BUILD.bazel stopped matching"

# A build action inherits NO environment. Astro runs under `node`, and the
# launchers are named by label, so a one-entry bin directory puts exactly
# those two on PATH. HOME and the pnpm store go into the execroot, the only
# writable space the sandbox leaves.
bin="$PWD/.bazel-bin"
mkdir -p "$bin"
ln -sf "$node" "$bin/node"
ln -sf "$pnpm" "$bin/pnpm"
HOME="$PWD/.bazel-home"
mkdir -p "$HOME"
PATH="$bin:/usr/bin:/bin"
CI=true
ASTRO_TELEMETRY_DISABLED=1
npm_config_manage_package_manager_versions=false
npm_config_store_dir="$HOME/.pnpm-store"
export HOME PATH CI ASTRO_TELEMETRY_DISABLED npm_config_manage_package_manager_versions npm_config_store_dir

# The one hard prerequisite, refused by name rather than as an include error
# mid-build. A count, not `[ -d ]`: an empty directory is the state to catch.
# `find -L`: Bazel materialises a declared source input as a SYMLINK.
published=$(find -L src/_scripts -type f -name '*.sh' | wc -l)
[ "$published" -gt 0 ] || fail \\
    "no published doc-script snippets under $PWD/src/_scripts - \\`task \\
website:scripts:publish\\` writes them (they are gitignored build output)"

# Build from a DEREFERENCED copy: vite resolves a symlinked module to its real
# path, so every page id would name the source tree while the page universe is
# keyed on execroot paths. `cp -RL` also leaves no path pointing out of the
# execroot. The changelog include reaches ../CHANGELOG.md, so the copy keeps
# the package directory one level below a root that holds it.
work="$PWD/.bazel-site"
rm -rf "$work"
mkdir -p "$work/website"
trap 'rm -rf "$work"' EXIT
cp -RL astro.config.mjs package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json plugins redirects.d src "$work/website/" \\
    || fail "could not dereference the site inputs into $work"
# The changelog page includes it from outside the package, so it is an input
# only once the root BUILD.bazel exports it; until then the include fails by name.
if [ -f ../CHANGELOG.md ]; then
    cp -L ../CHANGELOG.md "$work/CHANGELOG.md"
fi
cd "$work/website"

pnpm install --frozen-lockfile \\
    || fail "pnpm install --frozen-lockfile exited $? - pnpm-lock.yaml disagrees with package.json, \\
or the network this action declares with requires-network was unreachable"

pnpm exec astro build \\
    || fail "astro build exited $?"

dist=dist/docs
[ -d "$dist" ] || fail "astro exited 0 but wrote no $PWD/$dist"

# Floor on the reader, not on the exit code: zero rendered pages in an existing
# directory would tar up cleanly and hash consistently.
pages=$(find "$dist" -type f -name '*.html' | wc -l)
[ "$pages" -gt 0 ] || fail "$PWD/$dist holds 0 rendered pages"

# Schemas are a second tree at the site root, as in `task website:build`.
if [ -d "$dist/schemas" ]; then
    mv "$dist/schemas" dist/schemas
fi

# Deterministic metadata, so check (b) compares astro's output and never tar's
# framing of it.
tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu \\
    -cf "$out" -C dist . \\
    || fail "tar exited $? packing $PWD/dist"

[ -s "$out" ] || fail "tar exited 0 but wrote nothing to $out"
echo "site: $pages rendered pages packed from $PWD/$dist" >&2
"""

def site_target(name, srcs, doc_scripts, pnpm = "@tools//:pnpm", node = "@tools//:node"):
    """One coarse `genrule` producing `<name>.tar` — the rendered site.

    Args:
      name: the target name. `//website:site` is the label the ADR, the
        Taskfile and `scripts/bazel_hermeticity_proofs.py` all spell.
      srcs: every file astro reads, as one glob from `website/BUILD.bazel`.
        Coarse on purpose: the rule rebuilds or it does not.
      doc_scripts: the `//test/doc_scripts/*.sh` sources, as labels. C-023
        requires them; pass `[]` until `//test/doc_scripts` exports them (see
        this file's docstring) and expect `--check-declared` to red
        `hermetic-declared-input-missing`.
      pnpm: the pnpm launcher's label; resolved from `ocx.lock`, never `PATH`.
      node: the node launcher's label, same resolution.
    """
    if not srcs:
        fail("site_target: no srcs - the glob in website/BUILD.bazel matched nothing")

    _written_file(name = name + "_runner", text = _SITE_RUNNER)

    native.genrule(
        name = name,
        srcs = srcs + doc_scripts,
        outs = [name + ".tar"],
        cmd = "$(location :%s_runner) $(location %s) $(location %s) $(location package.json) $@" % (name, pnpm, node),
        tags = SITE_TAGS,
        tools = [":" + name + "_runner", pnpm, node],
        visibility = ["//visibility:public"],
    )
