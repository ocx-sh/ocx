---
// Terminal: a recorded cast played with asciinema-player in terminal-window chrome.
// Local copy of @ocx-sh/theme 0.1.1's component with a lazy cast: the file is fetched when the terminal
// scrolls near the viewport, or when its collapsed chrome opens, never on page load. Same props.
import { base } from 'astro:config/client';
import Button from '@ocx-sh/theme/components/ui/Button.astro';
import Icon from '@ocx-sh/theme/components/ui/Icon.astro';
import { nextTerminalId, withBase } from './terminal.mjs';

export interface Props {
  /** Path to a recorded `.cast` file, root-absolute and base-relative (`/casts/x.cast`); always prefixed with the site base. */
  src: string;
  /** Title shown centred in the chrome. */
  title?: string;
  /** Terminal width in columns. */
  cols?: number;
  /** Terminal height in rows; with `cols` (and fit 'width') reserves the player height before it loads. */
  rows?: number;
  /** Start playback on load. Default false (DOC-EX-15). */
  autoPlay?: boolean;
  /** Playback speed multiplier. Default 1. */
  speed?: number;
  /** Compress pauses longer than this many seconds. Default 2. */
  idleTimeLimit?: number;
  /** Loop playback. Default false. */
  loop?: boolean;
  /** How the player scales. Default 'width'; 'none' disables scaling. */
  fit?: 'width' | 'height' | 'both' | 'none';
  /** Render only the chrome; the chrome button expands the player. */
  collapsed?: boolean;
}

const {
  src,
  title,
  cols,
  rows,
  autoPlay = false,
  speed = 1,
  idleTimeLimit = 2,
  loop = false,
  fit = 'width',
  collapsed = false,
} = Astro.props;
const id = nextTerminalId();
const options = { cols, rows, autoPlay, speed, idleTimeLimit, loop, fit: fit === 'none' ? false : fit };
// ponytail: reserve only when both sizes are given; every live ocx usage is collapsed (no load-time shift).
const reserve = fit === 'width' && cols && rows ? `--_cols: ${cols}; --_rows: ${rows}` : undefined;
const startLabel = `Play ${title ?? 'terminal recording'}`;
const Chrome = collapsed ? 'button' : 'div';
const contentId = `${id}-content`;
const trigger = collapsed
  ? { type: 'button', 'aria-expanded': 'false', 'aria-controls': contentId, 'aria-label': title ? undefined : 'Terminal recording' }
  : undefined;
const content = collapsed ? { id: contentId, hidden: true } : { id: contentId };
const style = reserve;
---

<div
  class="ocx-terminal not-content"
  data-src={withBase(src, base)}
  data-options={JSON.stringify(options)}
  data-collapsed={collapsed ? '' : undefined}
>
  <Chrome class="ocx-terminal__chrome" {...trigger}>
    <span class="ocx-terminal__dots" aria-hidden="true">
      <span class="ocx-terminal__dot"></span>
      <span class="ocx-terminal__dot"></span>
      <span class="ocx-terminal__dot"></span>
    </span>
    {title && <span class="ocx-terminal__title">{title}</span>}
    {collapsed && <Icon name="chevron-down" class="ocx-terminal__chevron" />}
  </Chrome>
  <div class="ocx-terminal__player" {...content} style={style}>
    {/* ponytail: a static child of the mount target; asciinema's `insert()` prepends the player
        before any existing child (never clears it) so this survives create() untouched (WP13.2). */}
    {/* ponytail: no overlay with autoPlay (asciinema shows none either); autoPlay under reduced motion
        starts paused and then has only the control bar. */}
    {!autoPlay && (
      <div class="ocx-terminal__start">
        <button type="button" aria-label={startLabel} class="ocx-terminal__start-button">
          <Icon name="play" />
        </button>
      </div>
    )}
    <div class="ocx-terminal__controls" hidden>
      <Button iconOnly aria-label="Play" size="s" variant="ghost" class="ocx-terminal__play">
        <Icon name="play" class="ocx-terminal__play-icon" />
        <Icon name="pause" class="ocx-terminal__pause-icon" />
      </Button>
      <input
        type="range"
        class="ocx-terminal__seek"
        aria-label="Seek"
        min="0"
        max="1000"
        step="any"
        value="0"
        disabled
      />
      <span class="ocx-terminal__time" aria-hidden="true">
        <span class="ocx-terminal__current">0:00</span>/<span class="ocx-terminal__duration">0:00</span>
      </span>
      <Button iconOnly aria-label="Full screen" size="s" variant="ghost" class="ocx-terminal__fullscreen">
        <Icon name="fullscreen" class="ocx-terminal__fs-icon" />
        <Icon name="fullscreen-exit" class="ocx-terminal__fs-exit-icon" />
      </Button>
    </div>
  </div>
</div>

<script>
  import { mountTerminal } from './terminal.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('.ocx-terminal')) mountTerminal(root);
</script>

<style is:global>
  @layer ocx {
    .ocx-terminal {
      container-type: inline-size;
      border: var(--ocx-border-width) solid var(--ocx-color-border);
      border-radius: var(--ocx-radius-lg);
      background: var(--ocx-color-code-bg);
    }

    .ocx-terminal__chrome {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--ocx-space-3);
      width: 100%;
      margin: 0;
      padding: var(--ocx-space-3) var(--ocx-space-4);
      border: 0;
      border-radius: var(--ocx-radius-lg) var(--ocx-radius-lg) 0 0;
      font: inherit;
      color: inherit;
      text-align: left;
      background: var(--ocx-color-surface-subtle);
    }

    button.ocx-terminal__chrome {
      cursor: pointer;
      user-select: none;
      transition: background-color var(--ocx-duration-base);
    }
    button.ocx-terminal__chrome:hover {
      background: var(--ocx-color-surface);
    }
    button.ocx-terminal__chrome:focus-visible {
      outline: var(--ocx-focus-ring);
      outline-offset: var(--ocx-focus-offset-inset);
    }

    .ocx-terminal__dots {
      display: flex;
      gap: var(--ocx-space-2);
    }
    .ocx-terminal__dot {
      width: var(--ocx-icon-xs);
      height: var(--ocx-icon-xs);
      border-radius: var(--ocx-radius-sm);
      background: var(--ocx-color-danger);
    }
    .ocx-terminal__dot:nth-child(2) {
      background: var(--ocx-color-warning);
    }
    .ocx-terminal__dot:nth-child(3) {
      background: var(--ocx-color-success);
    }

    .ocx-terminal__title {
      grid-column: 2;
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-sm);
      line-height: var(--ocx-lh-heading);
      color: var(--ocx-color-fg-subtle);
      text-align: center;
    }
    button .ocx-terminal__title {
      color: var(--ocx-color-accent-fg);
      font-weight: var(--ocx-font-weight-medium);
    }

    /* Same treatment as the Accordion/Collapsible chevron: a registry icon whose box is centred on
     * the chrome's line (grid align-items), turned about its own centre, colour and motion on tokens
     * (reduced motion zeroes the duration). */
    .ocx-terminal__chevron {
      grid-column: 3;
      justify-self: end;
      align-self: center;
      color: var(--ocx-color-accent-fg);
      transform-origin: center;
      transition: rotate var(--ocx-duration-moderate) var(--ocx-ease-in-out);
    }
    [aria-expanded='true'] > .ocx-terminal__chevron {
      rotate: 180deg;
    }

    .ocx-terminal__player {
      position: relative;
      /* room for the start button while the player is not there yet and no rows reserve a height */
      min-height: calc(var(--ocx-control-xl) + 2 * var(--ocx-control-3xl));
      border-top: var(--ocx-border-width) solid var(--ocx-color-border);
      color: var(--ocx-color-code-fg);
    }
    /* Our start overlay (SSR, so it never pops in) replaces asciinema-player's: the poster area above
     * the 32px control bar, the play mark centred on it. The whole poster is the click target, as with
     * asciinema's; terminal.mjs hides it on the first play. */
    .ocx-terminal__start {
      position: absolute;
      inset: 0 0 var(--ocx-control-xl);
      z-index: 1;
      display: grid;
      place-items: center;
      cursor: pointer;
    }
    /* A bare accent play mark (owner: no button box, no rounding): the Lucide play glyph filled, with
     * mitred joins so its corners stay sharp. */
    .ocx-terminal__start-button {
      display: grid;
      place-items: center;
      padding: 0;
      color: var(--ocx-color-accent);
      background: none;
      border: 0;
      cursor: pointer;
      transition: color var(--ocx-duration-base) var(--ocx-ease-out);
    }
    .ocx-terminal__start-button:hover {
      color: var(--ocx-color-accent-hover);
    }
    .ocx-terminal__start-button:focus-visible {
      outline: var(--ocx-focus-ring);
      outline-offset: var(--ocx-focus-offset);
    }
    .ocx-terminal__start-button .ocx-icon {
      inline-size: var(--ocx-control-2xl);
      block-size: var(--ocx-control-2xl);
      fill: currentColor;
      stroke-linejoin: miter;
    }
    /* Exit only: it fades out on the first play (display allow-discrete holds it meanwhile) and is
     * never shown again. The transition lives on the hidden state alone: on the base rule, a style pass
     * before the sheet applies starts a display transition from block, and the start mark paints at the
     * top of the poster for half the duration (a layout shift on a loaded host). */
    .ocx-terminal__start[hidden] {
      display: none;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity var(--ocx-duration-base) var(--ocx-ease-out),
        display var(--ocx-duration-base) allow-discrete;
    }
    .ocx-terminal__player .ap-overlay-start {
      display: none;
    }
    /* Reserve the fit-width player height (no layout shift): asciinema-player lays the terminal out at
     * 15px — char 9px wide (0.6em mono advance), rows 20px high, 2 × 0.75em borders ≈ 22px — scales
     * that box to the container width, then adds its 32px control bar. Numbers are asciinema-player 3.15.1's,
     * not ours; re-measure on upgrade. Guarded by e2e "CLS is 0 on load and while the open player loads". */
    .ocx-terminal__player[style*='--_rows'] {
      min-height: calc(100cqi * (var(--_rows) * 20 + 22) / (var(--_cols) * 9 + 22) + 32px);
    }
    .ocx-terminal__player[hidden] {
      display: none;
    }
    .ocx-terminal__player .ap-player {
      border-radius: 0;
    }

    /* Our control bar replaces asciinema-player's own (created with `controls: false`): same 32px
     * the CLS reserve above already budgets, so no re-measure on this change. */
    .ocx-terminal__controls {
      display: flex;
      align-items: center;
      gap: var(--ocx-space-3);
      block-size: var(--ocx-control-xl);
      padding: 0 var(--ocx-space-3);
      border-top: var(--ocx-border-width) solid var(--ocx-color-border);
      background: var(--ocx-color-surface-subtle);
    }
    .ocx-terminal__controls[hidden] {
      display: none;
    }
    /* Quiet scrubber: thin neutral track, played part in muted ink (--_p from terminal.mjs), small
       square thumb. The input box stays control-height for the hit target. */
    .ocx-terminal__seek {
      flex: 1;
      appearance: none;
      block-size: var(--ocx-control-md);
      margin: 0;
      background: transparent;
      cursor: pointer;
    }
    .ocx-terminal__seek:disabled {
      cursor: default;
    }
    .ocx-terminal__seek::-webkit-slider-runnable-track {
      block-size: var(--ocx-seek-track);
      background: linear-gradient(
        to right,
        var(--ocx-color-fg-muted) calc(var(--_p, 0) * 100%),
        var(--ocx-color-border) 0
      );
    }
    .ocx-terminal__seek::-moz-range-track {
      block-size: var(--ocx-seek-track);
      background: linear-gradient(
        to right,
        var(--ocx-color-fg-muted) calc(var(--_p, 0) * 100%),
        var(--ocx-color-border) 0
      );
    }
    .ocx-terminal__seek::-webkit-slider-thumb {
      appearance: none;
      inline-size: var(--ocx-seek-thumb);
      block-size: var(--ocx-seek-thumb);
      margin-block-start: calc((var(--ocx-seek-track) - var(--ocx-seek-thumb)) / 2);
      background: var(--ocx-color-fg-muted);
      border: 0;
      border-radius: 0;
    }
    .ocx-terminal__seek::-moz-range-thumb {
      inline-size: var(--ocx-seek-thumb);
      block-size: var(--ocx-seek-thumb);
      background: var(--ocx-color-fg-muted);
      border: 0;
      border-radius: 0;
    }
    .ocx-terminal__seek:hover:not(:disabled)::-webkit-slider-thumb {
      background: var(--ocx-color-fg);
    }
    .ocx-terminal__seek:hover:not(:disabled)::-moz-range-thumb {
      background: var(--ocx-color-fg);
    }
    .ocx-terminal__seek:disabled::-webkit-slider-thumb {
      visibility: hidden;
    }
    .ocx-terminal__seek:disabled::-moz-range-thumb {
      visibility: hidden;
    }
    .ocx-terminal__seek:focus-visible {
      outline: var(--ocx-focus-ring);
      outline-offset: var(--ocx-focus-offset-inset);
    }
    /* Forced colours drop the gradient and paint the thumb Canvas: give track and thumb system
       colours (same pattern as choice.css). The disabled thumb stays hidden. */
    @media (forced-colors: active) {
      .ocx-terminal__seek::-webkit-slider-runnable-track,
      .ocx-terminal__seek::-moz-range-track {
        forced-color-adjust: none;
        background: GrayText;
      }
      .ocx-terminal__seek::-webkit-slider-thumb,
      .ocx-terminal__seek::-moz-range-thumb {
        forced-color-adjust: none;
        background: CanvasText;
      }
    }
    .ocx-terminal__time {
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-sm);
      color: var(--ocx-color-fg-subtle);
      white-space: nowrap;
    }
    /* Play/pause and fullscreen/exit: both glyphs stacked in one cell, the inactive one opacity 0.
       They crossfade only under the root's `data-live` (terminal.mjs, once the controls are wired). */
    .ocx-terminal__controls :is(.ocx-terminal__play, .ocx-terminal__fullscreen):not([hidden]) {
      display: inline-grid;
    }
    .ocx-terminal__controls :is(.ocx-terminal__play, .ocx-terminal__fullscreen) > svg {
      grid-area: 1 / 1;
    }
    .ocx-terminal__play .ocx-terminal__pause-icon,
    .ocx-terminal__controls[data-state='playing'] .ocx-terminal__play-icon,
    .ocx-terminal__fullscreen .ocx-terminal__fs-exit-icon,
    .ocx-terminal__controls[data-fullscreen] .ocx-terminal__fs-icon {
      opacity: 0;
      visibility: hidden;
      scale: 0.5;
    }
    .ocx-terminal__controls[data-state='playing'] .ocx-terminal__pause-icon,
    .ocx-terminal__controls[data-fullscreen] .ocx-terminal__fs-exit-icon {
      opacity: 1;
      visibility: visible;
      scale: 1;
    }
    .ocx-terminal[data-live] .ocx-terminal__controls svg {
      transition:
        opacity var(--ocx-duration-moderate) var(--ocx-ease-in-out),
        visibility var(--ocx-duration-moderate) var(--ocx-ease-in-out),
        scale var(--ocx-duration-moderate) var(--ocx-ease-in-out);
    }

    /* Fullscreen: the whole card fills the screen, the player area grows into the freed space. */
    .ocx-terminal:fullscreen {
      display: flex;
      flex-direction: column;
      background: var(--ocx-color-code-bg);
    }
    /* The player area is a column too: asciinema's wrapper is `height: 100%`, which in a definite-height
     * area filled it and pushed the control bar below the screen (fullscreen could not be exited by click). */
    .ocx-terminal:fullscreen .ocx-terminal__player {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .ocx-terminal:fullscreen .ap-wrapper {
      flex: 1;
      min-height: 0;
      align-items: center;
    }
    .ocx-terminal::backdrop {
      background: var(--ocx-color-code-bg);
    }

    /* asciinema theme 'ocx': ANSI 0–15 on the code tokens, both schemes through the token switch. */
    .asciinema-player-theme-ocx {
      --term-color-foreground: var(--ocx-color-code-fg);
      --term-color-background: var(--ocx-color-code-bg);
      --term-color-0: var(--ocx-color-code-comment);
      --term-color-1: var(--ocx-color-danger);
      --term-color-2: var(--ocx-color-code-string);
      --term-color-3: var(--ocx-color-code-number);
      --term-color-4: var(--ocx-color-code-keyword);
      --term-color-5: var(--ocx-color-code-variable);
      --term-color-6: var(--ocx-color-success);
      --term-color-7: var(--ocx-color-fg-muted);
      --term-color-8: var(--ocx-color-fg-subtle);
      --term-color-9: var(--ocx-color-danger);
      --term-color-10: var(--ocx-color-success);
      --term-color-11: var(--ocx-color-warning);
      --term-color-12: var(--ocx-color-keyword);
      --term-color-13: var(--ocx-color-accent-fg);
      --term-color-14: var(--ocx-color-success);
      --term-color-15: var(--ocx-color-fg);
    }
  }
</style>
