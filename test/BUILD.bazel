# The acceptance suite, as one `sh_test` per `tests/test_*.py` (C-024) — 172
# today, and the number is the filesystem's rather than this comment's: the
# `glob` below is the enumeration and `scripts/bazel_accept_proofs.py`'s
# `prove_counts` reds when its own constant drifts from `test/tests/`. The tag
# set, the serialisation decision, the measured table behind result caching and
# the under-declaration that survives it are all in `bazel.bzl`'s module
# docstring; this file is the enumeration and the input groups.

load("//test:bazel.bzl", "acceptance_suite")

# ---------------------------------------------------------------------------
# Root-package sources that `crates/*` targets reach across the package
# boundary.
#
# These 26 labels used to live in the ROOT `BUILD.bazel` as `//:test/...`.
# Declaring any BUILD file under `test/` makes `test/` a package, and a label
# may not reach into a subpackage: `//:test/sigstore/keys/fulcio-ca.crt.pem` is
# then invalid ("'test' is a subpackage"), by analysis error, on every target
# that names it. Measured on 9.2.0 against an otherwise empty `test/BUILD.bazel`
# — `bazel build --nobuild //...` went 0 -> 1 with 26 such errors from the root
# package and 37 more from seven `crates/*` packages.
#
# The half of that move this package owns is below. The other half — dropping
# the same 26 from the root `exports_files` and re-spelling `//:test/X` as
# `//test:X` in the seven crate BUILD files — has landed, so `//...` analyses
# today; the reasoning above is why the labels live here and not in the root
# package, and it is what a reader needs before moving one back.
#
# `exports_files` rather than a `filegroup`, for the reason the root package
# already recorded: each crate then depends on the individual files it reads,
# so editing an unrelated fixture does not invalidate its test action.
# ---------------------------------------------------------------------------
exports_files(
    [
        "sigstore/keys/fulcio-ca.crt.pem",
        "sigstore/keys/fulcio-ca.key.pem",
        "sigstore/keys/rekor.key.pem",
        "sigstore/keys/rekor.pub.pem",
        "sigstore/trusted_root.json",
        "tests/fixtures/golden/attestation_sidecar_key_envelope.json",
        "tests/fixtures/golden/attestation_sidecar_key_manifest.json",
        "tests/fixtures/golden/key_bundle.json",
        "tests/fixtures/golden/key_referrer_manifest.json",
        "tests/fixtures/golden/keyless_bundle.json",
        "tests/fixtures/golden/keyless_referrer_manifest.json",
        "tests/fixtures/golden/keys/cosign.key",
        "tests/fixtures/golden/keys/cosign.pub",
        "tests/fixtures/golden/sbom_sidecar_document.json",
        "tests/fixtures/golden/sbom_sidecar_manifest.json",
        "tests/fixtures/golden/simplesigning_key_manifest.json",
        "tests/fixtures/golden/simplesigning_key_payload.json",
        "tests/fixtures/golden/simplesigning_keyless_manifest.json",
        "tests/fixtures/golden/simplesigning_keyless_payload.json",
        "tests/fixtures/simplesigning/foreign_claim_type_payload.json",
        "tests/fixtures/simplesigning/foreign_subject_payload.json",
        "tests/fixtures/simplesigning/publisher_formatted_manifest.json",
        "tests/fixtures/simplesigning/publisher_formatted_payload.json",
        "tests/fixtures/simplesigning/tampered_signature_manifest.json",
        "tests/fixtures/simplesigning/untrusted_ca_manifest.json",
        "tests/test_index.py",
    ],
    visibility = ["//crates:__subpackages__"],
)

# The one runfile every acceptance target carries, and the three binaries the
# suite drives: `ocx`, `ocx-mirror`, and `ocx-shim` — the last only on the
# windows-latest leg, where `OCX_SHIM_BINARY` points `test_windows_shim.py` at
# it (`test/taskfile.yml:13`); its ELF is never executed on Linux. Measured:
# `bazel query 'labels(srcs, //test:suite_anchor)'` answers all three plus
# `conftest.py`, so the wildcard below is doing what this comment says.
#
# `conftest.py` is the anchor: the runner resolves its symlink to find the
# source tree, so it is load-bearing rather than decorative. `bin/ocx*` is
# globbed with `allow_empty = True` because `cargo` writes those binaries and a
# fresh clone has none — an absent `bin/ocx` is refused by the runner, out
# loud, rather than by an analysis error nobody can act on. A glob whose
# emptiness is silent is exactly the unfalsifiable shape, which is why the
# runtime check is the one that governs and this is only the declaration.
filegroup(
    name = "suite_anchor",
    srcs = ["conftest.py"] + glob(
        ["bin/ocx*"],
        allow_empty = True,
    ),
)

# Everything (nearly) every acceptance module reads that is NOT the module.
#
# The cache unit C-024 asks for is "one file, one target", and with result
# caching on (`bazel.bzl` § "Result caching is ON") the inputs have to carry
# that: a module changes, one target re-runs; a shared file changes, all of them
# do. So this group is kept to what is genuinely shared, and a file only a few
# modules read is declared on exactly those modules below (`module_data`) —
# before that split, an edit to `taskfile.yml`, `SUITE_FLOOR` or `bench/`
# re-ran all 172 targets on an unchanged binary.
#
# What stays here, and why each is shared rather than per-module:
#
#   * `conftest.py` (via `:suite_anchor`), `pyproject.toml`, `uv.lock`,
#     `src/**/*.py`, `tests/**` — the session hooks, the venv, and the helper
#     package 160-odd modules import; `tests/conftest.py` imports
#     `tests.fixtures.sigstore_stack`, so every module reads `tests/fixtures/`.
#   * `sigstore/**` — read by that conftest-imported fixture, so by all 172
#     (`scripts/bazel_tag_guard.py`'s derivation says so), and mounted into the
#     Fulcio/Rekor/CT containers.
#   * `docker-compose.yml`, `zot-config.json` — the stack every module runs
#     against; the second is mounted into the primary registry.
#   * `ocx.toml`, `ocx.lock` — `OcxRunner` exposes no `cwd=`, so every `ocx`
#     it starts runs in `test/` and its project walk finds these. An implicit
#     read the AST cannot see, so it stays on everyone.
#
# Not declared anywhere: `SUITE_FLOOR`, `SKIP_CEILING`, `XFAIL_CEILING` (read by
# the task gates over the JUnit reports, never by a module) and `docker/**`
# (the shell-matrix image build context, a `test/taskfile.yml` recipe).
#
# **The exclusions are the load-bearing half, and they were measured rather than
# guessed.** `glob` walks the filesystem and knows nothing about `.gitignore`, so
# a generated file inside a globbed directory would re-key every target on
# every run and "second run fully cached" would be unreachable. Measured by
# snapshotting every path under `test/` around a `task test:parallel --force`:
# `__pycache__/`, `.pytest_cache/`, `bin/ocx*` and `results/junit.xml` moved and
# nothing else — so `**/__pycache__/**` and `**/*.pyc` are the only exclusions a
# globbed directory needs, and `bench/results/` (gitignored `task test:bench`
# output) the one generated path under a globbed directory.
#
# **What this group contains is itself floored**, by
# `scripts/bazel_tag_guard.py`'s `SUITE_INPUTS_*` clause, and what each module
# reads is derived there too: a per-module read the AST can see and the target
# does not declare reds `tag-uncached-unlisted`. Moving a file out of this
# group without declaring it on its readers reds only for such a read; a read
# the AST cannot see (a `task` recipe, an implied lock file) reds through the
# guard's hand-kept `HAND_DECLARED_READS` / `IMPLIED_READS`; a module that
# launches `task` or names a path under a directory outside this group by
# string reds `tag-hand-read-unreviewed` until it has an entry there.
filegroup(
    name = "suite_inputs",
    srcs = [
        # `:suite_anchor` carries `conftest.py` and `bin/ocx*`; nested rather
        # than re-globbed so the runner's anchor and the cache key name one
        # group. It is the second label the tag guard requires.
        ":suite_anchor",
        "docker-compose.yml",
        "ocx.lock",
        "ocx.toml",
        "pyproject.toml",
        "uv.lock",
        "zot-config.json",
    ] + glob(
        [
            "sigstore/**",
            "src/**/*.py",
            "tests/**",
        ],
        allow_empty = False,
        exclude = [
            # Each module is its own target's input. Including them here would
            # make every module's edit re-run every target, which is the
            # selection C-024 exists to buy. A module that genuinely READS its
            # siblings is a sweep, and sweeps live in the lint tier
            # (`test/lint/`, outside this glob) — `scripts/bazel_tag_guard.py`
            # reds one found here. A module that IMPORTS a sibling declares
            # that one file in `module_data` below; the guard reds it if not.
            "tests/test_*.py",
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

# The per-module groups: each is declared on the modules that read it and no
# others (`module_data` below).

# `tests/test_bench_smoke.py` imports `bench.scenarios`, `bench.compare`,
# `bench.report`, `bench.baseline` and `bench.harness`, and `report` renders
# `dashboard/template.html`. `bench/results/` is `task test:bench` output.
filegroup(
    name = "bench_inputs",
    srcs = glob(
        ["bench/**"],
        allow_empty = False,
        exclude = [
            "bench/results/**",
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

# `recordings.setups` (the doc-script setup registry, imported by
# `src/state_providers.py` inside a function) and the cast layer.
filegroup(
    name = "recording_sources",
    srcs = glob(
        ["recordings/**/*.py"],
        allow_empty = False,
        exclude = ["**/__pycache__/**"],
    ),
)

filegroup(
    name = "scenario_scripts",
    srcs = glob(
        ["scenarios/**"],
        allow_empty = False,
    ),
)

filegroup(
    name = "suite_scripts",
    srcs = glob(
        ["scripts/**"],
        allow_empty = False,
        exclude = ["**/__pycache__/**"],
    ),
)

filegroup(
    name = "vendored_specs",
    srcs = glob(
        ["specs/**"],
        allow_empty = False,
    ),
)

# The project toolchain definition `ocx --project` reads (see `module_data`).
_PROJECT_TOOLCHAIN = [
    "//:ocx.lock",
    "//:ocx.toml",
]

_SCHEMA_BINARY_ENV = {"OCX_SCHEMA_BINARY": "$(rlocationpath //crates/ocx_schema:ocx_schema_bin)"}

# One target per module, named `//test:<module stem>`.
#
# `glob` rather than a list: the unit C-024 makes a target of is "a file in
# `test/tests/` named `test_*.py`", so the enumeration is the filesystem's and
# a module added without a target is not a state this package can be in.
# `allow_empty = False` is the floor — a glob that matched nothing would
# otherwise declare an empty package that `bazel build //test:all` reports
# success over.
#
# `module_data` is the per-module half of the declaration (C-020): what one
# module reads OUTSIDE this package, declared on that module's target only, so
# the edit re-runs the modules that read it and no others. Most entries are
# what `scripts/bazel_tag_guard.py`'s undeclared-read predicate derives from
# the module's AST (its own reads, its helpers', its conftests'), and the guard
# reds a module that reads such a path without declaring it. The rest —
# `:suite_scripts`, the root `ocx.lock` beside `ocx.toml`, the schema binary —
# are reads no AST sees, held by the guard's hand-kept `HAND_DECLARED_READS` /
# `IMPLIED_READS`. Either way an entry is removed by removing the read, never
# on its own.
acceptance_suite(
    name = "acceptance_runner",
    extra_pytest_args = ["-v"],
    module_data = {
        "tests/test_announce_e2e_evidence.py": ["//:.claude/artifacts/e2e_results_announce.md"],
        # An imported SIBLING module is a read too: `//test:suite_inputs`
        # excludes `tests/test_*.py`, so without this entry an edit to
        # `attest()` would leave this target's verdict cached (the tag guard
        # charges an importer with the sibling file and everything it reads).
        "tests/test_auto_verify.py": ["tests/test_attest.py"],
        "tests/test_bench_smoke.py": [":bench_inputs"],
        "tests/test_catalog_readme.py": ["//:packaging/ocx/CATALOG.md"],
        # `test/tests/fixtures/cosign.py` runs `ocx --project <root>/ocx.toml`,
        # which reads the lock beside it too.
        "tests/test_cosign_interop.py": _PROJECT_TOOLCHAIN,
        "tests/test_cosign_matrix_attest.py": _PROJECT_TOOLCHAIN,
        "tests/test_cosign_matrix_cosign_signs.py": _PROJECT_TOOLCHAIN,
        "tests/test_cosign_matrix_extras.py": _PROJECT_TOOLCHAIN,
        "tests/test_cosign_matrix_ocx_signs.py": _PROJECT_TOOLCHAIN,
        "tests/test_doc_scripts.py": _PROJECT_TOOLCHAIN + [
            ":recording_sources",
            "//test/doc_scripts:doc_script_sources",
        ],
        "tests/test_doc_scripts_cast.py": _PROJECT_TOOLCHAIN + [":recording_sources"],
        "tests/test_doc_scripts_executor.py": _PROJECT_TOOLCHAIN + [":recording_sources"],
        "tests/test_doc_scripts_one_tree.py": _PROJECT_TOOLCHAIN + [
            ":recording_sources",
            "//test/doc_scripts:doc_script_sources",
            "//website:recordings.taskfile.yml",
        ],
        # Runs `task website:scripts:publish` and `task test:doc-scripts:list`:
        # go-task parses the whole include graph (`test/taskfile.yml` among
        # it), the list task runs `test/scripts/doc_scripts_list.py`, and the
        # publish task runs `website/scripts/publish_doc_scripts.py` over
        # `test/doc_scripts/`. The list script is a recipe read no AST sees, so
        # `:suite_scripts` is declared by hand and held there by
        # `scripts/bazel_tag_guard.py` `HAND_DECLARED_READS`.
        "tests/test_doc_scripts_publish.py": [
            "taskfile.yml",
            ":suite_scripts",
            "//:taskfiles",
            "//test/doc_scripts:doc_script_sources",
            "//website:publish_scripts",
            "//website:taskfiles",
        ],
        "tests/test_execution_record_standards.py": [
            ":vendored_specs",
            "tests/test_execution_records.py",
        ],
        "tests/test_execution_records.py": ["//crates/ocx_schema:ocx_schema_bin"],
        "tests/test_lazy_loading.py": ["tests/test_patches.py"],
        "tests/test_project_env.py": ["//crates/ocx_schema:ocx_schema_bin"],
        "tests/test_purge.py": ["tests/test_assembly.py"],
        "tests/test_scenarios_smoke.py": [":scenario_scripts"],
        "tests/test_schema.py": ["//website:src/public/schemas/metadata/v1.json"],
        "tests/test_shell_reconcile.py": ["//website:src/docs/reference/command-line.md"],
        "tests/test_state_providers.py": _PROJECT_TOOLCHAIN + [":recording_sources"],
        "tests/test_state_registry_characterization.py": _PROJECT_TOOLCHAIN + [":recording_sources"],
        "tests/test_taplo_project_toolchain.py": ["//:taplo.toml"],
        "tests/test_trampoline_exec.py": ["//crates/ocx_store:shim_blobs"],
    },
    # The schema binary as the two modules that run it read it: an
    # rlocationpath the runner resolves (`bazel.bzl` `_RUNNER`).
    module_env = {
        "tests/test_execution_records.py": _SCHEMA_BINARY_ENV,
        "tests/test_project_env.py": _SCHEMA_BINARY_ENV,
    },
    # Every xdist group a module names (`bazel.bzl` § Concurrency): the module
    # holds the group's host lock for its whole run, because every target is
    # its own process — and so is the same target run from a sibling
    # checkout — where xdist would have put the group on one worker. A group
    # only one module names (`test_doc_scripts`' two fixed-identifier slots)
    # needs it as much as a shared one. `patch_global_slot` is the bare
    # registry's one reserved `global` patch repository, which
    # `test_patches.py` writes on purpose (`lint/test_patch_global_slot.py`
    # keeps every other patch tier on a path of its own).
    # `scripts/bazel_tag_guard.py` derives this map from source and reds a
    # mismatch in either direction.
    module_slots = {
        "tests/test_doc_scripts.py": [
            "managed_config_corp_slot",
            "mytool_repo_slot",
        ],
        "tests/test_patches.py": ["patch_global_slot"],
    },
    modules = glob(
        ["tests/test_*.py"],
        allow_empty = False,
    ),
)

# C-022's declared-input set for the cast recording targets. They live in
# //test/doc_scripts, which cannot glob across the package boundary, so the
# inputs are exported from the package that owns them. WP-33 measured that
# every route around this is worse: an ambient digest probe never re-observes
# (a constant that freezes 39 action keys while reading like a live edge), a
# source symlink to ../bin/ocx dangles on a fresh clone, and
# --workspace_status_command belongs to another WP's file.
filegroup(
    name = "recording_inputs",
    srcs = [
        "conftest.py",
        "pyproject.toml",
        "scripts/doc_scripts_list.py",
        "uv.lock",
    ] + glob(
        [
            "recordings/**/*.py",
            "src/**/*.py",
        ],
        allow_empty = False,
    ) + glob(
        # C-022 names one binary: `ocx`. `bin/` also holds `ocx-mirror` (a
        # different product, `ocx-sh/ocx-mirror`, vendored here) and `ocx-shim`
        # (the Windows launcher, exercised only by the windows-latest leg) — no
        # recording executes either, so a `bin/ocx*` wildcard would re-key all
        # 39 casts on a rebuild of a binary none of them runs. Measured:
        # `bazel query 'labels(srcs, //test:recording_inputs)'` answered all
        # three under the wildcard.
        #
        # A constant pattern inside `glob` rather than a plain `srcs` entry
        # because `bin/ocx` is a gitignored `cargo` output, absent on a fresh
        # clone, and `allow_empty = True` is what keeps analysis working there;
        # the runner refuses an absent binary out loud at recording time. That
        # costs the buildifier warning below, which is the narrower of the two
        # evils and is disabled by name rather than by widening the match.
        # buildifier: disable=constant-glob
        ["bin/ocx"],
        allow_empty = True,
    ),
    visibility = ["//test/doc_scripts:__pkg__"],
)
