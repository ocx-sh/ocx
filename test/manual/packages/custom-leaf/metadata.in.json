{
  "type": "bundle",
  "version": 1,
  "env": [
    {
      "key": "PATH",
      "type": "path",
      "required": true,
      "value": "${installPath}/bin",
      "visibility": "public"
    },
    {
      "key": "CUSTOM_LEAF_HOME",
      "type": "constant",
      "value": "${installPath}",
      "visibility": "public"
    }
  ],
  "entrypoints": {
    "custom-leaf": {}
  },
  "integrations": {
    "sh.ocx.leaf": {
      "declaredBy": "custom-leaf",
      "edge": "interface",
      "leafRoot": "${self.installPath}"
    }
  }
}
