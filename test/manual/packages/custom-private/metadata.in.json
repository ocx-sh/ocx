{
  "type": "bundle",
  "version": 1,
  "env": [
    {
      "key": "PATH",
      "type": "path",
      "required": true,
      "value": "${installPath}/bin",
      "visibility": "public"
    },
    {
      "key": "CUSTOM_PRIVATE_HOME",
      "type": "constant",
      "value": "${installPath}",
      "visibility": "public"
    }
  ],
  "entrypoints": {
    "custom-private": {}
  },
  "integrations": {
    "com.example.private": {
      "declaredBy": "custom-private",
      "edge": "private",
      "privateRoot": "${self.installPath}"
    }
  }
}
